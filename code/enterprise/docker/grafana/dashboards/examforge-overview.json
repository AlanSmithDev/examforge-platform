{
  "title": "智卷云 · 服务总览（G3）",
  "uid": "examforge-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "服务存活（up）",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=~\"examforge-.*\"}", "legendFormat": "{{job}}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "QPS（按服务）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"examforge-.*\"}[1m]))", "legendFormat": "{{application}}" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 5xx 错误率（按服务）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{
        "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\",application=~\"examforge-.*\"}[5m])) / clamp_min(sum by (application) (rate(http_server_requests_seconds_count{application=~\"examforge-.*\"}[5m])), 0.001)",
        "legendFormat": "{{application}}"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.005 } ] } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "网关 P99 延迟",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"examforge-gateway\"}[5m])))", "legendFormat": "P99" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "支付回调结果速率（docs/19 §5 P0 数据源）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [{ "expr": "sum by (result) (rate(examforge_payment_callback_total[10m]))", "legendFormat": "{{result}}" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "JVM 堆内存使用率（按服务）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [{
        "expr": "jvm_memory_used_bytes{area=\"heap\",application=~\"examforge-.*\"} / clamp_min(jvm_memory_max_bytes{area=\"heap\",application=~\"examforge-.*\"}, 1)",
        "legendFormat": "{{application}}"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.8 } ] } }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "MySQL 连接池使用率（HikariCP，按服务）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [{
        "expr": "hikaricp_connections_active{application=~\"examforge-.*\"} / clamp_min(hikaricp_connections_max{application=~\"examforge-.*\"}, 1)",
        "legendFormat": "{{application}}"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.8 } ] } }, "overrides": [] }
    }
  ]
}
